[user]
name = Carl-Louis Van Brandt
email = clvanbrandt@gmail.com
signingkey = 739A993E31ACEFB8
[fetch]
	prune = true
[commit]
	gpgsign = true
[core]
	excludesfile = /Users/clvanbrandt/.config/.gitignore
[rerere]
	enabled = true
	autoupdate = true
[alias]
    st = status
    ck = checkout
    sw = switch
    cm = commit
    cane = commit --amend --no-edit
    pf = push --force-with-lease
	root = rev-parse --show-toplevel
[init]
	defaultBranch = main
[push]
	useForceIfIncludes = true
